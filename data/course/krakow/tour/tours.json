[{"id":"royal-route","personaId":"historian","titles":{"en":"The Royal Route","pl":"Droga Królewska","zh":"皇家之路"},"summaries":{"en":"The classic Royal Route through Kraków's Old Town: from the Barbican and St Florian's Gate across the Main Market Square, then along Grodzka and Kanonicza streets up to Wawel Hill. 11 stops, about 2 km on foot.","pl":"Klasyczna Droga Królewska przez Stare Miasto w Krakowie: od Barbakanu i Bramy Floriańskiej przez Rynek Główny, a dalej ulicami Grodzką i Kanoniczą aż na Wawel. 11 przystanków, około 2 km pieszo.","zh":"穿越克拉科夫老城的经典皇家之路：从瓮城和圣福里安门出发，穿过中央集市广场，再沿格罗兹卡街和咏祷司铎街走上瓦维尔山。共11站，步行约2公里。"},"stops":[{"poiId":"poi_wd_Q807309","dwellS":120,"prize":4,"triggerRadiusM":35,"approachRadiusM":110},{"poiId":"poi_wd_Q1363724","dwellS":90,"prize":3,"triggerRadiusM":35,"approachRadiusM":110},{"poiId":"poi_wd_Q1143171","dwellS":240,"prize":5,"triggerRadiusM":60,"approachRadiusM":110},{"poiId":"poi_wd_Q1072350","dwellS":180,"prize":4,"triggerRadiusM":70,"approachRadiusM":110},{"poiId":"poi_wd_Q348381","dwellS":90,"prize":3,"triggerRadiusM":50,"approachRadiusM":110},{"poiId":"poi_wd_Q1786361","dwellS":120,"prize":3,"triggerRadiusM":50,"approachRadiusM":110},{"poiId":"poi_wd_Q898260","dwellS":90,"prize":2,"triggerRadiusM":50,"approachRadiusM":110},{"poiId":"poi_wd_Q338657","dwellS":150,"prize":4,"triggerRadiusM":45,"approachRadiusM":110},{"poiId":"poi_wd_Q1195738","dwellS":120,"prize":3,"triggerRadiusM":35,"approachRadiusM":110},{"poiId":"poi_wd_Q8255537","dwellS":120,"prize":3,"triggerRadiusM":35,"approachRadiusM":110},{"poiId":"poi_wd_Q743704","dwellS":300,"prize":5,"triggerRadiusM":60,"approachRadiusM":110}],"fixedStartPoiId":"poi_wd_Q807309","fixedEndPoiId":"poi_wd_Q743704","estMinutes":55}]