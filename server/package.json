{
  "name": "citytour-server",
  "version": "1.0.0",
  "private": true,
  "description": "CityTour course server: signed course catalog/manifests, content-addressed blobs, runtime studio voice (docs/SERVER.md)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "keygen": "npm run build && node dist/cli/keygen.js",
    "publish-course": "npm run build && node dist/cli/publish-course.js",
    "publish-city": "npm run build && node dist/cli/publish-city.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
